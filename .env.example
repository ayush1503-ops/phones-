# Postgres connection string (use a pooled/serverless URL for Vercel functions).
# Set this for Development, Preview and Production in Vercel project settings.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Optional: public canonical site URL, e.g. https://dumbphones.co.in after DNS cutover.
# Vercel uses its deployment URL automatically if this is omitted.
# NEXT_PUBLIC_SITE_URL=https://dumbphones.co.in
