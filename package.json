{
  "name": "dumbphones-store",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:web": "concurrently -k -n storefront,api -c yellow,blue \"npm:dev:vite\" \"npm:dev:api\"",
    "dev:vite": "vite --host 0.0.0.0 --port 3000",
    "dev:api": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "build:api": "next build",
    "build:web": "vite build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:api": "next start --hostname 0.0.0.0 --port 3001",
    "start:web": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "assets:vendor": "node scripts/vendor-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "^16.4.0",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.0",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  }
}
